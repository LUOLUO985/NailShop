.page {
  padding: 24rpx 24rpx 60rpx;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.tip {
  font-size: 23rpx;
  color: #a08b93;
}

.add-btn {
  width: 190rpx;
  height: 68rpx;
  line-height: 68rpx;
  padding: 0;
  font-size: 27rpx;
}

.goods-card {
  display: flex;
  padding: 20rpx;
  margin-bottom: 20rpx;
  background: #fff;
  border-radius: 18rpx;
  box-shadow: 0 4rpx 14rpx rgba(78, 45, 58, 0.05);
}

.goods-thumb {
  width: 148rpx;
  height: 148rpx;
  border-radius: 12rpx;
  background: #f2edef;
  flex-shrink: 0;
}

.goods-main {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.goods-name {
  font-size: 30rpx;
  font-weight: 600;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.goods-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}

.price {
  color: #d84e7e;
  font-weight: 700;
  font-size: 29rpx;
}

.stock {
  color: #a08b93;
  font-size: 22rpx;
}

.status-row {
  margin-top: 10rpx;
}

.status {
  display: inline-block;
  padding: 2rpx 14rpx;
  font-size: 21rpx;
  border-radius: 16rpx;
}

.status-on {
  background: #e9f8ef;
  color: #2f9b64;
}

.status-off {
  background: #f2f2f2;
  color: #8f878a;
}

.goods-actions {
  display: flex;
  flex-direction: column;
  justify-content: center;
  margin-left: 12rpx;
}

.mini-btn {
  margin: 6rpx 0;
  padding: 0 18rpx;
  font-size: 22rpx;
  line-height: 48rpx;
  height: 48rpx;
  background: #f5f0f2;
  color: #4a4043;
}

.mini-btn.on {
  background: #e9f8ef;
  color: #2f9b64;
}

.mini-btn.off {
  background: #f7ede9;
  color: #d08058;
}

.mini-btn.danger {
  background: #fbeaea;
  color: #c95a5a;
}

.modal-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 100;
  background: rgba(35, 25, 29, 0.55);
  display: flex;
  align-items: flex-end;
}

.modal {
  width: 100%;
  max-height: 86vh;
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  display: flex;
  flex-direction: column;
}

.modal-title {
  padding: 30rpx 32rpx 20rpx;
  font-size: 34rpx;
  font-weight: 700;
  text-align: center;
}

.modal-body {
  max-height: 54vh;
  padding: 0 32rpx;
  box-sizing: border-box;
}

.field {
  margin-bottom: 26rpx;
}

.field-row {
  display: flex;
  justify-content: space-between;
}

.field.half {
  width: 48%;
}

.label {
  margin-bottom: 12rpx;
  font-size: 25rpx;
  color: #7d6e74;
}

.input {
  padding: 18rpx 22rpx;
  background: #faf7f8;
  border-radius: 12rpx;
  font-size: 29rpx;
}

.uploader {
  display: flex;
  flex-wrap: wrap;
}

.thumb-wrap {
  position: relative;
  width: 140rpx;
  height: 140rpx;
  margin: 0 18rpx 18rpx 0;
}

.thumb {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  background: #f2edef;
}

.thumb-remove {
  position: absolute;
  right: -12rpx;
  top: -12rpx;
  width: 36rpx;
  height: 36rpx;
  line-height: 32rpx;
  border-radius: 50%;
  background: #4a4043;
  color: #fff;
  text-align: center;
  font-size: 28rpx;
}

.add-thumb {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 140rpx;
  height: 140rpx;
  border: 2rpx dashed #dccbd2;
  border-radius: 12rpx;
  color: #bdaab2;
  background: #fdfbfc;
}

.add-plus {
  font-size: 48rpx;
  line-height: 1;
}

.add-text {
  margin-top: 8rpx;
  font-size: 22rpx;
}

.modal-footer {
  display: flex;
  padding: 20rpx 32rpx 34rpx;
}

.cancel-btn {
  width: 200rpx;
  margin-right: 20rpx;
  background: #f2edef;
  color: #4a4043;
}

.save-btn {
  flex: 1;
}
