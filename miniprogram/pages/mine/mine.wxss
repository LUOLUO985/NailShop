.page {
  padding: 24rpx 24rpx 60rpx;
}

.empty {
  padding: 180rpx 40rpx;
  text-align: center;
  color: #a08b93;
  font-size: 26rpx;
}

.notice-list {
  padding-top: 10rpx;
}

.notice-item {
  display: flex;
  padding: 28rpx 24rpx;
  margin-bottom: 22rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 18rpx rgba(78, 45, 58, 0.05);
}

.notice-left {
  position: relative;
  margin-right: 22rpx;
  flex-shrink: 0;
}

.notice-badge {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #f2b7cd, #d84e7e);
  color: #fff;
  font-size: 30rpx;
  text-align: center;
  line-height: 80rpx;
}

.notice-dot {
  position: absolute;
  top: -2rpx;
  right: -2rpx;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #ff4d4f;
  border: 3rpx solid #fff;
}

.notice-main {
  flex: 1;
  min-width: 0;
}

.notice-title-row {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.notice-title {
  font-size: 31rpx;
  font-weight: 700;
  color: #33282d;
}

.notice-new {
  margin-left: 14rpx;
  padding: 2rpx 10rpx;
  border-radius: 16rpx;
  background: #fde8ef;
  color: #d84e7e;
  font-size: 18rpx;
  font-weight: 600;
}

.notice-content {
  display: block;
  color: #6d5f64;
  font-size: 26rpx;
  line-height: 1.75;
  white-space: pre-line;
  word-break: break-word;
}
