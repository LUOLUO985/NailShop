<!--pages/mine/mine.wxml-->
<view class="page">
  <view wx:if="{{notifications.length === 0}}" class="empty">
    {{i18n.notifications.empty}}
  </view>

  <view wx:else class="notice-list">
    <view class="notice-item" wx:for="{{notifications}}" wx:key="id">
      <view class="notice-left">
        <view class="notice-badge">通</view>
        <view wx:if="{{item.unread}}" class="notice-dot"></view>
      </view>
      <view class="notice-main">
        <view class="notice-title-row">
          <text class="notice-title">
            {{lang === 'en' && item.titleEn ? item.titleEn : item.title}}
          </text>
          <text wx:if="{{item.unread}}" class="notice-new">NEW</text>
        </view>
        <text class="notice-content">{{item.content}}</text>
      </view>
    </view>
  </view>
</view>
