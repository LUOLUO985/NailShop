<!--pages/admin_setting/admin_setting.wxml-->
<view class="page">
  <view class="card">
    <view class="card-title">{{i18n.adminSetting.title}}</view>
    <view class="card-desc">
      {{i18n.adminSetting.desc}}
    </view>

    <view class="qr-box">
      <block wx:if="{{loading}}">
        <view class="qr-empty">{{i18n.common.loading}}</view>
      </block>
      <block wx:elif="{{qrFileID}}">
        <image class="qr-img" src="{{qrFileID}}" mode="aspectFit" />
        <view class="current-tip">{{i18n.adminSetting.current}}</view>
      </block>
      <block wx:else>
        <view class="qr-empty">{{i18n.adminSetting.empty}}</view>
      </block>
    </view>

    <button
      class="btn-primary upload-btn"
      loading="{{uploading}}"
      disabled="{{uploading}}"
      bindtap="chooseQr"
    >
      {{qrFileID ? i18n.adminSetting.change : i18n.adminSetting.upload}}
    </button>

    <view class="notice">
      <view class="notice-title">{{i18n.adminSetting.noticeTitle}}</view>
      <view class="notice-line">{{i18n.adminSetting.notice1}}</view>
      <view class="notice-line">{{i18n.adminSetting.notice2}}</view>
      <view class="notice-line">{{i18n.adminSetting.notice3}}</view>
    </view>
  </view>
</view>
