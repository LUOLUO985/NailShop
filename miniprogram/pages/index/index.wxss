.page {
  padding: 0 24rpx 40rpx;
}

.single-page-tip {
  margin: 0 -24rpx 18rpx;
  padding: 18rpx 24rpx;
  background: #fde8ef;
  color: #b04a6b;
  font-size: 24rpx;
  line-height: 1.5;
}

.hero {
  position: relative;
  width: 750rpx;
  height: 620rpx;
  margin-left: -24rpx;
  overflow: hidden;
  border-radius: 0 0 36rpx 36rpx;
}

.hero-bg {
  width: 100%;
  height: 100%;
}

.hero-mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: linear-gradient(
    to bottom,
    rgba(25, 12, 17, 0.32),
    rgba(25, 12, 17, 0.6)
  );
}

.hero-content {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 56rpx;
  text-align: center;
  color: #fff;
}

.brand-name {
  font-family: "STKaiti", "KaiTi", "Kaiti SC", serif;
  font-size: 92rpx;
  font-weight: 700;
  letter-spacing: 10rpx;
  text-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.35);
}

.brand-sub {
  margin-top: 10rpx;
  font-size: 26rpx;
  letter-spacing: 6rpx;
  opacity: 0.92;
}

.demo-category {
  margin-bottom: 18rpx;
  padding: 22rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 18rpx rgba(78, 45, 58, 0.05);
}

.demo-title {
  margin-bottom: 16rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #33282d;
}

.demo-video {
  width: 100%;
  height: 380rpx;
  border-radius: 14rpx;
  background: #000;
}

.toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 36rpx 8rpx 22rpx;
}

.category-tabs {
  display: flex;
  flex: 1;
  align-items: center;
}

.category-tab {
  margin-right: 22rpx;
  padding: 10rpx 28rpx;
  border-radius: 30rpx;
  background: #f1eaed;
  color: #7d6b72;
  font-size: 27rpx;
}

.category-tab.active {
  background: #d84e7e;
  color: #fff;
  font-weight: 600;
}

.category-tab:last-child {
  margin-right: 0;
}

.lang-btn {
  margin-left: 18rpx;
  padding: 8rpx 22rpx;
  border-radius: 26rpx;
  background: #fff;
  color: #8a5a69;
  border: 2rpx solid #e7cdd6;
  font-size: 23rpx;
}

.price-unit {
  margin-left: 2rpx;
  font-size: 22rpx;
  font-weight: 400;
  color: #b66a83;
}

.goods-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.goods-card {
  width: 342rpx;
  margin-bottom: 22rpx;
  background: #fff;
  border-radius: 18rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 18rpx rgba(78, 45, 58, 0.06);
}

.img-wrap {
  position: relative;
  width: 342rpx;
  height: 342rpx;
}

.goods-img {
  display: block;
  width: 100%;
  height: 100%;
  background: #f2edef;
}

.sold-tag {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  background: rgba(51, 40, 45, 0.78);
  color: #fff;
  font-size: 22rpx;
}

.goods-info {
  padding: 18rpx 20rpx 22rpx;
}

.goods-name {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  min-height: 76rpx;
  font-size: 29rpx;
  color: #33282d;
}

.goods-code {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #a08b93;
}

.goods-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}

.price {
  color: #d84e7e;
  font-size: 32rpx;
  font-weight: 700;
}

.stock {
  font-size: 22rpx;
  color: #a08b93;
}

.stock-empty {
  color: #c95a5a;
}
