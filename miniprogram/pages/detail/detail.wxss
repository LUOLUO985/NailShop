.swiper {
  width: 750rpx;
  height: 750rpx;
  background: #efe9eb;
}

.swiper-img {
  width: 750rpx;
  height: 750rpx;
}

.video-list {
  padding: 24rpx;
}

.demo-video {
  width: 100%;
  height: 420rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: #000;
}

.demo-video + .demo-video {
  margin-top: 20rpx;
}

.body {
  padding: 24rpx 24rpx 60rpx;
}

.info-card,
.contact-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 18rpx rgba(78, 45, 58, 0.05);
}

.product-name {
  font-size: 38rpx;
  font-weight: 700;
  color: #33282d;
}

.product-code {
  display: inline-block;
  margin-bottom: 10rpx;
  padding: 2rpx 16rpx;
  border-radius: 18rpx;
  background: #fde8ef;
  color: #d84e7e;
  font-size: 23rpx;
}

.product-desc {
  margin-top: 18rpx;
  color: #8b7f84;
  font-size: 26rpx;
}

.product-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
}

.product-price {
  color: #d84e7e;
  font-size: 40rpx;
  font-weight: 700;
}

.product-stock {
  font-size: 25rpx;
  color: #8b7f84;
}

.stock-empty {
  color: #c95a5a;
}

.sold-tip {
  margin-top: 22rpx;
  padding: 18rpx 22rpx;
  background: #fdf0f0;
  color: #c95a5a;
  font-size: 26rpx;
  border-radius: 12rpx;
}

.contact-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
}

.qr-wrap {
  display: flex;
  justify-content: center;
  padding: 12rpx 0;
}

.qr-img {
  width: 420rpx;
  height: 420rpx;
  border-radius: 16rpx;
  background: #fff;
  border: 2rpx solid #f0e8eb;
}

.qr-empty {
  padding: 80rpx 20rpx;
  text-align: center;
  color: #a08b93;
  background: #faf7f8;
  border-radius: 16rpx;
}

.contact-tip {
  margin-top: 24rpx;
  text-align: center;
  font-size: 25rpx;
  color: #7a6b71;
}

.state {
  padding: 160rpx 40rpx;
  text-align: center;
  color: #9a9396;
}
