.swiper {
  width: 750rpx;
  height: 750rpx;
  background: #efe9eb;
}

.swiper-img {
  width: 750rpx;
  height: 750rpx;
}

.video-list {
  padding: 24rpx;
}

.demo-video {
  width: 100%;
  height: 420rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: #000;
}

.demo-video + .demo-video {
  margin-top: 20rpx;
}

.body {
  padding: 24rpx 24rpx 60rpx;
}

.info-card,
.contact-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 18rpx rgba(78, 45, 58, 0.05);
}

.product-name {
  font-size: 38rpx;
  font-weight: 700;
  color: #33282d;
}

.product-size {
  display: inline-flex;
  align-items: center;
  margin-top: 14rpx;
  padding: 6rpx 18rpx;
  border-radius: 22rpx;
  background: #f5f0f2;
}

.size-label {
  margin-right: 10rpx;
  font-size: 24rpx;
  color: #8b7f84;
}

.size-value {
  font-size: 26rpx;
  font-weight: 600;
  color: #4a4043;
}

.product-code {
  display: inline-block;
  margin-bottom: 10rpx;
  padding: 2rpx 16rpx;
  border-radius: 18rpx;
  background: #fde8ef;
  color: #d84e7e;
  font-size: 23rpx;
}

.product-desc {
  margin-top: 18rpx;
  color: #8b7f84;
  font-size: 26rpx;
}

.product-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
}

.product-price {
  color: #d84e7e;
  font-size: 40rpx;
  font-weight: 700;
}

.detail-unit {
  margin-left: 4rpx;
  font-size: 25rpx;
  font-weight: 400;
  color: #b66a83;
}

.product-stock {
  font-size: 25rpx;
  color: #8b7f84;
}

.stock-empty {
  color: #c95a5a;
}

.sold-tip {
  margin-top: 22rpx;
  padding: 18rpx 22rpx;
  background: #fdf0f0;
  color: #c95a5a;
  font-size: 26rpx;
  border-radius: 12rpx;
}

.contact-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
}

.wechat-search-tip {
  margin-bottom: 16rpx;
  font-size: 25rpx;
  color: #7a6b71;
}

.wechat-id-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
  padding: 18rpx 22rpx;
  background: #faf7f8;
  border-radius: 12rpx;
}

.wechat-id {
  font-size: 29rpx;
  font-weight: 600;
  color: #33282d;
  word-break: break-all;
}

.wechat-copy {
  flex-shrink: 0;
  margin-left: 18rpx;
  padding: 6rpx 22rpx;
  border-radius: 22rpx;
  background: #d84e7e;
  color: #fff;
  font-size: 23rpx;
}

.qr-wrap {
  display: flex;
  justify-content: center;
  padding: 12rpx 0;
}

.qr-img {
  width: 420rpx;
  height: 420rpx;
  border-radius: 16rpx;
  background: #fff;
  border: 2rpx solid #f0e8eb;
}

.qr-empty {
  padding: 80rpx 20rpx;
  text-align: center;
  color: #a08b93;
  background: #faf7f8;
  border-radius: 16rpx;
}

.contact-tip {
  margin-top: 24rpx;
  text-align: center;
  font-size: 25rpx;
  color: #7a6b71;
}

.contact-note {
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  background: #fdf5f8;
  color: #b04a6b;
  border-radius: 12rpx;
  font-size: 25rpx;
  text-align: center;
}

.state {
  padding: 160rpx 40rpx;
  text-align: center;
  color: #9a9396;
}

.single-page-tip {
  padding: 18rpx 24rpx;
  background: #fde8ef;
  color: #b04a6b;
  font-size: 24rpx;
  line-height: 1.5;
}

.error-actions {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.btn-plain {
  margin-top: 20rpx;
  width: 240rpx;
  font-size: 28rpx;
  color: #8a5a69;
  background: #fff;
  border: 2rpx solid #e7cdd6;
  border-radius: 44rpx;
}

.share-card {
  padding: 30rpx;
  text-align: center;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 18rpx rgba(78, 45, 58, 0.05);
}

.share-title {
  margin-bottom: 20rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #33282d;
}

.share-btn {
  display: inline-block;
  width: auto;
  height: 72rpx;
  padding: 0 54rpx;
  line-height: 68rpx;
  font-size: 28rpx;
  color: #fff;
  background: #d84e7e;
  border-radius: 36rpx;
}

.share-btn::after {
  border: none;
}

.share-btn-hover {
  background: #c2436f;
}

.share-tip {
  margin-top: 18rpx;
  font-size: 23rpx;
  color: #a08b93;
}
