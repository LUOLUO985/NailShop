<!--pages/admin_media/admin_media.wxml-->
<view class="page">
  <view class="intro-card">
    <view class="intro-title">{{i18n.adminMedia.title}}</view>
    <view class="intro-desc">{{i18n.adminMedia.subtitle}}</view>
  </view>

  <view class="upload-card">
    <button
      class="btn-primary upload-btn"
      loading="{{uploading}}"
      disabled="{{uploading}}"
      bindtap="chooseAndUpload"
    >
      {{i18n.adminMedia.choose}}
    </button>
    <view class="upload-note">{{i18n.adminMedia.chooseNote}}</view>

    <button
      wx:if="{{hasLocalSamples}}"
      class="migrate-btn"
      loading="{{uploading}}"
      disabled="{{uploading}}"
      bindtap="migrateLocalSamples"
    >
      {{i18n.adminMedia.migrateButton}}
    </button>
    <view wx:if="{{hasLocalSamples}}" class="migrate-note">
      {{i18n.adminMedia.migrateNote}}
    </view>
  </view>

  <view class="list-card">
    <view class="list-title">{{i18n.adminMedia.listTitle}}</view>
    <view wx:if="{{uploadedItems.length === 0}}" class="empty">
      {{i18n.adminMedia.empty}}
    </view>
    <block wx:if="{{uploadedItems.length > 0}}">
      <view
        class="file-item"
        wx:for="{{uploadedItems}}"
        wx:key="fileID"
      >
        <view class="file-type {{item.type === 'video' ? 'type-video' : 'type-image'}}">
          {{item.type === 'video' ? i18n.adminMedia.videoLabel : i18n.adminMedia.imageLabel}}
        </view>
        <view class="file-main">
          <text wx:if="{{item.label}}" class="file-label">{{item.label}}</text>
          <text class="file-id" selectable="{{true}}">{{item.fileID}}</text>
        </view>
        <button
          class="copy-btn"
          size="mini"
          data-fileid="{{item.fileID}}"
          bindtap="copyFileID"
        >
          {{i18n.adminMedia.copy}}
        </button>
      </view>
    </block>
  </view>

  <view class="steps-card">
    <view class="steps-title">{{i18n.adminMedia.stepsTitle}}</view>
    <view class="step-text">{{i18n.adminMedia.step1}}</view>
    <view class="step-text">{{i18n.adminMedia.step2}}</view>
    <view class="step-text">{{i18n.adminMedia.step3}}</view>
  </view>
</view>
